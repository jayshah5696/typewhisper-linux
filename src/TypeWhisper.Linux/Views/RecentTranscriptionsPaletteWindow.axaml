<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TypeWhisper.Linux.ViewModels"
        xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
        x:Class="TypeWhisper.Linux.Views.RecentTranscriptionsPaletteWindow"
        x:DataType="vm:RecentTranscriptionsPaletteViewModel"
        Title="{loc:Str RecentTranscriptions.Title}"
        Width="640"
        Height="700"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent">
    <Border CornerRadius="8"
            Background="{DynamicResource TwPaletteBackgroundBrush}"
            BorderBrush="{DynamicResource TwBorderStrongBrush}"
            BorderThickness="1"
            Padding="14">
        <Grid RowDefinitions="Auto,Auto,150,*,Auto">
            <TextBlock Text="{loc:Str RecentTranscriptions.Title}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="2,0,0,10" />

            <TextBox x:Name="SearchBox"
                     Grid.Row="1"
                     Text="{Binding SearchQuery}"
                     AutomationProperties.Name="{loc:Str RecentTranscriptions.SearchPlaceholder}"
                     PlaceholderText="{loc:Str RecentTranscriptions.SearchPlaceholder}"
                     Margin="0,0,0,10" />

            <Grid Grid.Row="2">
                <ListBox x:Name="EntriesList"
                         ItemsSource="{Binding FilteredEntries}"
                         SelectedItem="{Binding SelectedItem}"
                         AutomationProperties.Name="{loc:Str RecentTranscriptions.Title}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem" x:DataType="vm:RecentTranscriptionPaletteItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentTranscriptionPaletteItem">
                            <Border Padding="10,8"
                                    Background="Transparent"
                                    PointerReleased="Entry_PointerReleased">
                                <StackPanel>
                                    <TextBlock Text="{Binding FinalText}"
                                               Foreground="{DynamicResource TwTextStrongBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxHeight="42" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{DynamicResource TwTextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{loc:Str RecentTranscriptions.Empty}"
                           Foreground="{DynamicResource TwTextSecondaryBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !HasFilteredEntries}" />
            </Grid>
            <ScrollViewer Grid.Row="3" Margin="0,10,0,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding SelectedCleanupStatus}" TextWrapping="Wrap" Foreground="#FFD18B" />
                    <TextBlock Text="{loc:Str Recovery.PreviousResult}" />
                    <TextBox Text="{Binding SelectedFinalText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="70"
                             AutomationProperties.Name="{loc:Str Recovery.PreviousResult}" />
                    <TextBlock Text="{loc:Str Recovery.Original}" />
                    <TextBox Text="{Binding SelectedOriginalText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="70"
                             AutomationProperties.Name="{loc:Str Recovery.Original}" />
                    <WrapPanel>
                        <Button Content="{loc:Str Recovery.CopyOriginal}" Command="{Binding CopyOriginalCommand}" Margin="0,0,8,6" />
                        <Button Content="{loc:Str Recovery.CleanAgain}" Command="{Binding CleanAgainCommand}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Str Recovery.ProviderHint}" TextWrapping="Wrap" Foreground="#8A9AAE" FontSize="11" />
                    <TextBlock Text="{Binding RecoveryStatus}" TextWrapping="Wrap" Foreground="#FFD18B" />
                    <TextBlock Text="{loc:Str Recovery.NewResult}" />
                    <TextBox Text="{Binding RecoveryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="90"
                             AutomationProperties.Name="{loc:Str Recovery.NewResult}" />
                    <Button Content="{loc:Str Recovery.CopyResult}" Command="{Binding CopyRecoveryCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="4" Content="{loc:Str Recovery.InsertSelected}" Click="InsertSelected_Click"
                    IsEnabled="{Binding HasFilteredEntries}" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
