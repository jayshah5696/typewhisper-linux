<Project>
    <PropertyGroup>
        <Version Condition="'$(Version)' == ''">0.19.1</Version>
        <Company>Excel on the Web</Company>
        <Product>TypeWhisper</Product>
        <Copyright>Copyright © 2026 Excel on the Web. Portions © 2026 TypeWhisper.</Copyright>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <WarningsAsErrors>$(WarningsAsErrors);CS8509;IDE0057;IDE0066;IDE1006;CA1510;CA1511;CA1512;CA1513;CA1826;CA1859;CA1860;CA1865;CA1866;CA1867;CA2201;SYSLIB1045</WarningsAsErrors>
    </PropertyGroup>
</Project>
